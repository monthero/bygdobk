{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "crons": [{ "path": "/api/keepalive", "schedule": "17 5 * * *" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/kalender.ics",
      "destination": "https://zlxdoolpodirahjjsoqy.supabase.co/functions/v1/calendar"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:page(trening|arrangementer|nyheter|medlemskap|klubben|kontakt|personvern)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/medlemskap/bli-medlem",
      "destination": "/medlemskap/bli-medlem/index.html"
    },
    {
      "source": "/:locale(en|sv|da|fi|is|zh)",
      "destination": "/:locale/index.html"
    },
    {
      "source": "/:locale(en|sv|da|fi|is|zh)/:page(trening|arrangementer|nyheter|medlemskap|klubben|kontakt|personvern)",
      "destination": "/:locale/:page/index.html"
    },
    {
      "source": "/:locale(en|sv|da|fi|is|zh)/medlemskap/bli-medlem",
      "destination": "/:locale/medlemskap/bli-medlem/index.html"
    },
    {
      "source": "/:path((?!api/|assets/)[^.]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|LinkedInBot|Discordbot|WhatsApp|TelegramBot|SkypeUriPreview|redditbot|Pinterestbot|Embedly|Mastodon|Bluesky|Iframely).*"
        }
      ],
      "destination": "/api/preview?path=/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/shell.html"
    }
  ]
}
