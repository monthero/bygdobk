{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/kalender.ics",
      "destination": "https://zlxdoolpodirahjjsoqy.supabase.co/functions/v1/calendar"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
